{% comment %}Use Cloudflare's manual installation mode; automatic injection bypasses the visitor's preference.{% endcomment %}
{% assign cloudflare_token = site.cloudflare_analytics | default: '' | strip %}
{% assign cloudflare_enabled = false %}
{% if jekyll.environment == 'production' and cloudflare_token != '' and page.analytics != false %}
  {% assign cloudflare_enabled = true %}
{% endif %}
{% if cloudflare_enabled or page.analytics_preferences %}
  <script
    defer
    src="{{ '/assets/js/analytics.js' | relative_url }}"
    {% if cloudflare_enabled %}
      data-token="{{ cloudflare_token | escape }}"
    {% endif %}
  ></script>
{% endif %}
